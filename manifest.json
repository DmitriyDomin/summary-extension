{
  "manifest_version": 3,
  "name": "Content Summarizer",
  "version": "1.0",
  "web_accessible_resources": [
    {
      "resources": ["summary.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "description": "Generate summaries of web content using GPT-4 API.",
  "permissions": ["contextMenus", "activeTab", "tabs", "storage", "unlimitedStorage", "sidePanel", "scripting"],
  "action": {
    "default_title": "Open side panel"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["api-errors.js", "api-service.js", "content.js"],
      "exclude_matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://chat.openai.com/*", "*://chatgpt.com/*", "*://*.udemy.com/*"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["api-errors.js", "api-service.js", "library-store.js", "chatgpt-integration.js", "youtube-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"],
      "js": ["api-errors.js", "api-service.js", "chatgpt-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.udemy.com/*"],
      "js": ["api-errors.js", "api-service.js", "chatgpt-integration.js", "n8n-integration.js", "udemy-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "24": "images/icon24.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "default_locale": "en"
}
